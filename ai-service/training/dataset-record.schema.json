{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/spec-training-record",
  "title": "SpecPairTrainingRecord",
  "description": "One labeled example for supervised fine-tuning or distillation. Strip PII and get license clearance before use.",
  "type": "object",
  "required": ["id", "messages"],
  "properties": {
    "id": { "type": "string", "description": "Stable anonymized id" },
    "domain": { "type": "string", "description": "Optional coarse domain tag" },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant"] },
          "content": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source": { "type": "string", "description": "Internal ref only; do not ship customer names" },
        "task": {
          "type": "string",
          "enum": ["same_intent", "contradiction", "attribute_quality", "other"]
        },
        "gold_label": { "type": "object", "description": "Structured labels from human review" }
      }
    }
  }
}
